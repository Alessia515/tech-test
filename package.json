{
  "name": "talk-to-your-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/api.test.ts tests/worker.test.ts tests/validator.test.ts tests/comparison.test.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "data": "node scripts/download-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "inspect:data": "node scripts/inspect-data.mjs",
    "reference:data": "node scripts/reference-answers.mjs",
    "test:spike": "node scripts/browser-spike.mjs",
    "test:validator": "node --experimental-strip-types --test tests/validator.test.ts",
    "test:worker": "node --experimental-strip-types --test tests/worker.test.ts",
    "worker:fixture": "wrangler dev --config wrangler.fixture.jsonc --persist-to .wrangler/fixture --ip 127.0.0.1 --port 8787",
    "worker:live": "wrangler dev --persist-to .wrangler/live --ip 127.0.0.1 --port 8787",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "build:worker": "wrangler deploy --dry-run --outdir work/worker-build",
    "test:worker:http": "node scripts/test-worker-http.mjs",
    "smoke:live": "node --experimental-strip-types scripts/smoke-live.mjs",
    "test:api": "node --experimental-strip-types --test tests/api.test.ts",
    "test:comparison": "node --experimental-strip-types --test tests/comparison.test.ts",
    "evaluate:live": "node scripts/evaluate-live.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "node-sql-parser": "5.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  }
}
